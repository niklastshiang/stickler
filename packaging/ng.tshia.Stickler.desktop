[Desktop Entry]
Type=Application
Name=Stickler
Comment=Write the drums of a song as sheet music
Exec=stickler-gtk %f
Icon=ng.tshia.Stickler
Terminal=false
StartupNotify=true
Categories=AudioVideo;Audio;Music;
Keywords=drums;drummer;sheet music;transcription;MusicXML;
MimeType=audio/mpeg;audio/flac;audio/x-flac;audio/wav;audio/x-wav;audio/ogg;audio/x-vorbis+ogg;
