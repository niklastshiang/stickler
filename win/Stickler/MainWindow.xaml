<Window
    x:Class="Stickler.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Stickler"
    Title="Stickler">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!-- Design screens W4, W5, W7 and W8 (docs/design/win/): the menu bar on Mica, the header
         with the song once one is open, and the page the core's state asks for. Every text is
         set from code, from po/ through the string tables. -->
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <MenuBar Grid.Row="0">
            <MenuBarItem x:Name="FileMenu">
                <MenuFlyoutItem x:Name="OpenItem" Click="OnOpen">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="O" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSubItem x:Name="RecentMenu" />
                <MenuFlyoutSubItem x:Name="ExportMenu">
                    <MenuFlyoutItem x:Name="ExportPdfItem" Click="OnExportPdf" />
                    <MenuFlyoutItem x:Name="ExportMusicXmlItem" Click="OnExportMusicXml" />
                    <MenuFlyoutItem x:Name="ExportDrumTrackItem" Click="OnExportDrumTrack" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Name="OpenWithItem" Click="OnOpenWith" />
                </MenuFlyoutSubItem>
                <MenuFlyoutItem x:Name="CloseSongItem" Click="OnCloseSong">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="W" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="BackUpItem" Click="OnBackUp" />
                <MenuFlyoutItem x:Name="RestoreItem" Click="OnRestore" />
                <MenuFlyoutItem x:Name="RemoveItem" Click="OnRemoveModels" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="ExitItem" Click="OnExit" />
            </MenuBarItem>
            <!-- W8: the note size (module win-sheet); the keys are set in code (Ctrl+Plus and the keypad's) -->
            <MenuBarItem x:Name="ViewMenu">
                <MenuFlyoutItem x:Name="ZoomInItem" Click="OnZoomIn" />
                <MenuFlyoutItem x:Name="ZoomOutItem" Click="OnZoomOut" />
                <MenuFlyoutItem x:Name="ActualSizeItem" Click="OnActualSize" />
            </MenuBarItem>
            <MenuBarItem x:Name="HelpMenu">
                <MenuFlyoutItem x:Name="HelpItem" Click="OnHelp" />
                <MenuFlyoutItem x:Name="LicencesItem" Click="OnLicences" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="AboutItem" Click="OnAbout" />
            </MenuBarItem>
        </MenuBar>

        <!-- the song's header: title, then artist, tempo and time signature; Open and Export -->
        <Grid x:Name="Header" Grid.Row="1" Padding="24,12,24,12" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="SongTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SongSubtitle" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="OpenButton" Click="OnOpen" />
                <DropDownButton x:Name="ExportButton">
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem x:Name="ExportPdfButton" Click="OnExportPdf" />
                            <MenuFlyoutItem x:Name="ExportMusicXmlButton" Click="OnExportMusicXml" />
                            <MenuFlyoutItem x:Name="ExportDrumTrackButton" Click="OnExportDrumTrack" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="OpenWithButton" Click="OnOpenWith" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
        </Grid>

        <!-- the pages lie on a layer above Mica -->
        <Grid Grid.Row="2" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">

            <!-- W4: the drop area and the recent songs -->
            <ScrollViewer x:Name="EmptyPage" Visibility="Collapsed">
                <StackPanel Width="560" Margin="24,48,24,24" Spacing="24" HorizontalAlignment="Center">
                    <Border x:Name="DropArea" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop"
                            Padding="24,40,24,40" CornerRadius="8"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="2"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel HorizontalAlignment="Center" Spacing="12">
                            <FontIcon Glyph="&#xE8D6;" FontSize="40" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="DropText" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                            <Button x:Name="OpenSongButton" Click="OnOpen" HorizontalAlignment="Center" Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                    </Border>
                    <StackPanel x:Name="RecentPanel" Spacing="4">
                        <TextBlock x:Name="RecentHeading" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <StackPanel x:Name="RecentRows" Spacing="4" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- W5: the steps of an analysis or a drum track -->
            <StackPanel x:Name="StepsPage" Visibility="Collapsed" MaxWidth="560" Margin="24,48,24,24" Spacing="16" VerticalAlignment="Top">
                <StackPanel x:Name="StepRows" Spacing="12" />
                <Button x:Name="CancelButton" Click="OnCancel" HorizontalAlignment="Right" />
            </StackPanel>

            <!-- what went wrong with a song -->
            <StackPanel x:Name="FailedPage" Visibility="Collapsed" MaxWidth="560" Margin="24,48,24,24" Spacing="12" VerticalAlignment="Top">
                <TextBlock x:Name="FailedTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                <TextBlock x:Name="FailedDescription" TextWrapping="Wrap" />
                <Expander x:Name="FailedDetailsExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <TextBlock x:Name="FailedDetails" FontFamily="Consolas" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                </Expander>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button x:Name="RetryButton" Click="OnRetry" Style="{StaticResource AccentButtonStyle}" />
                    <Button x:Name="OpenAnotherButton" Click="OnOpen" />
                </StackPanel>
            </StackPanel>

            <!-- W6: the sheet music (module win-sheet) -->
            <local:SheetView x:Name="ResultPage" Visibility="Collapsed" />

            <!-- the core has ended -->
            <StackPanel x:Name="StoppedPage" Visibility="Collapsed" MaxWidth="560" Margin="24,48,24,24" Spacing="12" VerticalAlignment="Top">
                <TextBlock x:Name="StoppedTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                <TextBlock x:Name="StoppedText" TextWrapping="Wrap" />
                <Expander x:Name="StoppedDetailsExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <TextBlock x:Name="StoppedDetails" FontFamily="Consolas" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                </Expander>
                <Button x:Name="StartAgainButton" Click="OnStartAgain" HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <!-- W7: after saving, a note with "Show in Folder"; other notes the same way -->
        <TeachingTip x:Name="NoticeTip" Grid.Row="2" PreferredPlacement="BottomRight" IsLightDismissEnabled="True"
                     ActionButtonClick="OnShowInFolder" />
    </Grid>
</Window>
