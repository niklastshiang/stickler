<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Windows app (SPEC.md, module `win-shell`): WinUI 3, unpackaged and self-contained
       (the .NET and Windows App SDK runtimes next to the .exe, no MSIX), x64, Windows 11. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <RootNamespace>Stickler</RootNamespace>
    <AssemblyName>Stickler</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <!-- LibraryImport generates its marshalling code (NativeMethods: GetDpiForWindow) -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.7.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SticklerCore\SticklerCore.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Strings\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- the tempo mark's font for the PDF (module win-sheet), the same file as the other apps' -->
    <Content Include="..\..\packaging\fonts\Leipzig.ttf" Link="Leipzig.ttf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
