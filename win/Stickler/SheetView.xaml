<UserControl
    x:Class="Stickler.SheetView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Design screen W6 (docs/design/win/Sheet.dc.html): the pages on the grey desk, drawn by
         WebView2 from the core's SVG. The desk's colour shows until the first page is there. -->
    <Grid x:Name="Desk">
        <WebView2 x:Name="Web" IsTabStop="False" />
        <!-- the PDF's page (scope 4): laid out but never seen -->
        <WebView2 x:Name="Printer" Width="1" Height="1" Opacity="0" IsHitTestVisible="False" IsTabStop="False"
                  HorizontalAlignment="Left" VerticalAlignment="Top" />
    </Grid>
</UserControl>
