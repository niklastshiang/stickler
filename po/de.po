msgid "The Notes Are Ready"
msgstr "Die Noten sind fertig"

#: src/stickler_gtk/ui/window.py:105
msgid "The sheet music will be shown here."
msgstr "Hier werden die Noten angezeigt."

#: src/stickler_gtk/ui/window.py:110
msgid "Recent"
msgstr "Zuletzt geöffnet"

#: src/stickler_gtk/ui/window.py:145
msgid "Songs"
msgstr "Songs"

#: src/stickler_gtk/ui/window.py:164
msgid "Not an audio file"
msgstr "Keine Audiodatei"

#: src/stickler_gtk/ui/window.py:202
msgid "Recent songs could not be saved: {reason}"
msgstr "Die zuletzt geöffneten Songs konnten nicht gespeichert werden: {reason}"

#: src/stickler_gtk/ui/window.py:215
msgid "Remove from the List"
msgstr "Aus der Liste entfernen"

