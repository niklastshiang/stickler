#: src/stickler_gtk/logic/session.py:102
msgid ""
"Stickler needs these models before it can listen: {models}. Set them up once "
"in a terminal:"
msgstr "Stickler braucht diese Modelle, bevor es zuhören kann: {models}. Richten Sie sie einmal im Terminal ein:"

#: src/stickler_gtk/logic/session.py:106
msgid "Models Not Set Up"
msgstr "Modelle nicht eingerichtet"

#: src/stickler_gtk/logic/session.py:109
msgid "“{name}” cannot be read. Is it a complete sound file?"
msgstr "„{name}“ kann nicht gelesen werden. Ist es eine vollständige Audiodatei?"

#: src/stickler_gtk/logic/session.py:113
msgid "Cannot Read This File"
msgstr "Datei kann nicht gelesen werden"

#: src/stickler_gtk/logic/session.py:118
msgid "Something went wrong while listening to “{name}”."
msgstr "Beim Anhören von „{name}“ ist etwas schiefgegangen."

#: src/stickler_gtk/logic/session.py:120
msgid "The Analysis Failed"
msgstr "Die Analyse ist fehlgeschlagen"

#: src/stickler_gtk/logic/steps.py:13
msgid "Only the drum track, without the band"
msgstr "Nur die Schlagzeugspur, ohne die Band"

#: src/stickler_gtk/logic/steps.py:13
msgid "Separate the drums"
msgstr "Schlagzeug heraustrennen"

#: src/stickler_gtk/logic/steps.py:14
msgid "Detect the hits"
msgstr "Schläge erkennen"

#: src/stickler_gtk/logic/steps.py:14
msgid "Kick, snare, toms, hi-hat, cymbals"
msgstr "Bass Drum, Snare, Toms, Hi-Hat, Becken"

#: src/stickler_gtk/logic/steps.py:15
msgid "Find the beat and the bars"
msgstr "Beat und Takte finden"

#: src/stickler_gtk/logic/steps.py:15
msgid "Tempo, time signature, the first “one”"
msgstr "Tempo, Taktart, die erste „Eins“"

#: src/stickler_gtk/logic/steps.py:16
msgid "Bars, repeats, beams"
msgstr "Takte, Wiederholungen, Balken"

#: src/stickler_gtk/logic/steps.py:16
msgid "Write the notes"
msgstr "Noten schreiben"

#: src/stickler_gtk/logic/steps.py:17
msgid "Make the PDF"
msgstr "PDF erstellen"

#: src/stickler_gtk/logic/steps.py:17
msgid "To print or to read on a tablet"
msgstr "Zum Drucken oder Lesen auf dem Tablet"

#: src/stickler_gtk/ui/window.py:30
msgid "Drop a Song Here"
msgstr "Song hier ablegen"

#: src/stickler_gtk/ui/window.py:32
msgid ""
"Stickler listens to the drums and writes them as sheet music. MP3, FLAC, WAV "
"or OGG; a song takes about 15 seconds."
msgstr ""
"Stickler hört auf das Schlagzeug und schreibt es als Noten. MP3, FLAC, WAV "
"oder OGG; ein Song dauert etwa 15 Sekunden."

#: src/stickler_gtk/ui/window.py:35
msgid "Open a Song…"
msgstr "Song öffnen …"

#: src/stickler_gtk/ui/window.py:44
msgid "Done"
msgstr "Fertig"

#: src/stickler_gtk/ui/window.py:52
msgid "Waiting"
msgstr "Wartet"

#: src/stickler_gtk/ui/window.py:66
msgid "Open…"
msgstr "Öffnen …"

#: src/stickler_gtk/ui/window.py:68 src/stickler_gtk/ui/window.py:139
msgid "Open a Song"
msgstr "Song öffnen"

#: src/stickler_gtk/ui/window.py:74
msgid "Cancel"
msgstr "Abbrechen"

#: src/stickler_gtk/ui/window.py:80
msgid "Writing the Drum Part"
msgstr "Schlagzeugstimme wird geschrieben"

#: src/stickler_gtk/ui/window.py:84 src/stickler_gtk/ui/window.py:215
msgid "Technical Details"
msgstr "Technische Details"

#: src/stickler_gtk/ui/window.py:86
msgid "Try Again"
msgstr "Erneut versuchen"

#: src/stickler_gtk/ui/window.py:89
msgid "Open Another Song…"
msgstr "Anderen Song öffnen …"

#: src/stickler_gtk/ui/window.py:100
msgid "The Notes Are Ready"
msgstr "Die Noten sind fertig"

#: src/stickler_gtk/ui/window.py:101
msgid "The sheet music will be shown here."
msgstr "Hier werden die Noten angezeigt."

#: src/stickler_gtk/ui/window.py:135
msgid "Songs"
msgstr "Songs"

#: src/stickler_gtk/ui/window.py:154
msgid "Not an audio file"
msgstr "Keine Audiodatei"

#: src/stickler_gtk/ui/window.py:215
msgid "Commands"
msgstr "Befehle"